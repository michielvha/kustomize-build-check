{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  packageRules: [
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      automerge: false,
      groupName: null,
    },
    {
      matchManagers: ['github-actions'],
      matchDatasources: ['github-digest'],
      automerge: false,
    },
  ],
}
