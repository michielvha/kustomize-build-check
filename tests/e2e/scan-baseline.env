# Measured scan baseline. CI compares the built image against these numbers.
#
# Measured 2026-08-14 with Trivy against the alpine-based image released as the
# predecessor of the Wolfi swap (kustomize v5.8.1, helm v4.2.3, Go 1.26.5).
#
# The important column is WHERE the findings are. Both the alpine and the Wolfi
# image report ZERO os-pkgs findings: there is no OS-package CVE surface in
# either, so the base image is not what drives this number.
BASELINE_TOTAL=75
BASELINE_OS_PKGS=0
BASELINE_OURS=10       # our binary: Go stdlib, fixed by building with 1.26.6
BASELINE_HELM=10       # helm's vendored dependencies
BASELINE_KUSTOMIZE=55  # kustomize's vendored dependencies

# Not reachable from this repo. kustomize v5.8.1 is the latest release, so its 55
# findings can only move when upstream updates its dependencies. They are
# accepted, not ignored: the number is asserted below so a regression is visible.
MAX_TOTAL=75
MAX_OURS=0
